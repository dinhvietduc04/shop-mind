{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "mcp;localhost;127.0.0.1;[::1]",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=shopmind;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "shopmind-dev-secret-key-change-me-please-32chars!",
    "Issuer": "ShopMind",
    "Audience": "ShopMind",
    "ExpiryMinutes": 120
  },
  "Mcp": {
    "Audience": "Shop.Mcp",
    "KeyPrefix": "shop:mcp:rl:",
    "ReadPerMin": 30,
    "WritePerMin": 12,
    "QuotePerMin": 4,
    "WindowSeconds": 60,
    "MaxArgsBytes": 4096,
    "MaxResultBytes": 32768,
    "MaxPageSize": 50
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true,
    "DefaultTtlSeconds": 90
  }
}
