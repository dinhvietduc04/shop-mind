{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=shopmind;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Url": "amqp://guest:guest@localhost:5672"
  },
  "Outbox": {
    "PollSeconds": 2,
    "MaxBackoffSeconds": 60,
    "BatchSize": 50,
    "MaxAttempts": 3
  },
  "OutboxRetention": {
    "KeepDays": 30,
    "IntervalHours": 24
  }
}
